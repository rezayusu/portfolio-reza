# Copy this file to .env and replace the placeholder passwords before starting the app.
# Spring Boot loads .env automatically for local development.
# Do not commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/scrapbook_portfolio
DB_USERNAME=portfolio_app
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_USERNAME=portfolio-admin
# Use a strong password. In production, use a managed secret store.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SERVER_PORT=8080
UPLOAD_DIR=uploads
# Gmail SMTP: use a Google App Password, not your account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
FEEDBACK_NOTIFICATION_TO=rezayusuf651@gmail.com
